---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const handbook = await getCollection('handbook');
const russian = handbook
  .filter((entry) => entry.id.startsWith('ru/'))
  .sort((a, b) => a.data.order - b.data.order);

const glossary = await getCollection('glossary');
const base = import.meta.env.BASE_URL;
---

<Base title="Szkoła" tab="szkola" lead="Jak to tu działa. Как здесь всё устроено.">
  <section>
    <h2 class="mb-3 text-sm font-medium uppercase tracking-wide opacity-70">Przewodnik</h2>
    <ul class="flex flex-col gap-3">
      {
        russian.map((entry) => (
          <li class="rounded-xl border border-[var(--color-line)] bg-[var(--color-ink-soft)]/60 p-4">
            <h3 class="font-medium">{entry.data.title}</h3>
            <p class="mt-1 text-sm opacity-80">{entry.data.summary}</p>
            {entry.data.legalBasis.length > 0 ? (
              <p class="mt-2 text-xs opacity-60">{entry.data.legalBasis.join(' · ')}</p>
            ) : null}
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mt-8">
    <h2 class="mb-3 text-sm font-medium uppercase tracking-wide opacity-70">
      Słownik, {glossary.length} haseł
    </h2>
    <dl class="grid grid-cols-1 gap-2 sm:grid-cols-2">
      {
        glossary.map((entry) => (
          <div class="rounded-lg border border-[var(--color-line)] p-3">
            <dt class="font-medium">{entry.data.pl}</dt>
            <dd class="text-sm opacity-80">{entry.data.ru}</dd>
            {entry.data.note?.ru ? (
              <dd class="mt-1 text-xs opacity-60">{entry.data.note.ru}</dd>
            ) : null}
          </div>
        ))
      }
    </dl>
  </section>

  <section class="mt-8 rounded-xl border border-[var(--color-line)] p-4">
    <h2 class="font-medium">Kontakt</h2>
    <p class="mt-2 text-sm opacity-80">
      Technikum Kinematograficzno-Komputerowe im. Krzysztofa Kieślowskiego<br />
      ul. Polna 7, 00-625 Warszawa<br />
      22 825 02 52
    </p>
    <p class="mt-2 text-sm opacity-80">
      Metro <strong>Politechnika</strong>, linia M1. Numery tramwajów i autobusów zmieniają się,
      dlatego prowadzimy do żywego rozkładu zamiast wpisywać je na stałe.
    </p>
    <p class="mt-3 text-xs opacity-60">
      Godziny sekretariatu podawane są rozbieżnie: 9:00–14:00 na stronie szkoły i 8:00–15:00 w BIP.
      Warto potwierdzić telefonicznie.
    </p>
    <a class="mt-3 inline-block text-sm underline" href={`${base}`}>Wróć do „Dziś”</a>
  </section>
</Base>
