---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Timetable from '../components/Timetable';
import TestRuleCheck from '../components/TestRuleCheck';
import type { SubjectRef } from '../lib/domain/timetable';

const entries = await getCollection('subjects');
const subjects: SubjectRef[] = entries.map((entry) => ({
  id: entry.data.id,
  pl: entry.data.name.pl,
  ru: entry.data.name.ru,
  textbook: entry.data.textbook,
}));
---

<Base
  title="Plan"
  tab="dzis"
  lead="Do którego dzwonka, co wziąć na jutro i czy sprawdzian zapowiedziano legalnie."
>
  <Timetable client:load subjects={subjects} />

  <div class="mt-2">
    <TestRuleCheck client:load subjects={subjects} />
  </div>

  <p class="mt-7 text-micro text-[var(--color-faint)]">
    Szkoła nie publikuje ani planu lekcji, ani rozkładu dzwonków, dlatego oba wpisujesz raz i
    zostają na tym urządzeniu. · Школа не публикует ни расписание уроков, ни расписание звонков,
    поэтому и то и другое вводится один раз и остаётся на этом устройстве.
  </p>
</Base>
