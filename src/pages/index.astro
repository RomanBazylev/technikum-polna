---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Destination from '../components/Destination.astro';
import ObligationList from '../components/ObligationList';
import TodayHero from '../components/TodayHero';
import type { Obligation } from '../lib/domain/obligations';
import type { SubjectRef } from '../lib/domain/timetable';

const entries = await getCollection('obligations');
const obligations = entries.map((entry) => entry.data as Obligation);
const subjectEntries = await getCollection('subjects');
const subjects: SubjectRef[] = subjectEntries.map((entry) => ({
  id: entry.data.id,
  pl: entry.data.name.pl,
  ru: entry.data.name.ru,
  textbook: entry.data.textbook,
}));
const lektury = await getCollection('lektury');
const audiobooks = lektury.filter((entry) => entry.data.hasAudio).length;
const base = import.meta.env.BASE_URL;
---

<Base title="Dziś" tab="dzis">
  <header slot="header" class="mb-5">
    <h1 class="text-label font-semibold uppercase tracking-[0.16em] text-[var(--color-faint)]">
      TKK Polna · 1B
    </h1>
  </header>

  <TodayHero client:load subjects={subjects} />

  <h2 class="mt-7 mb-2 text-label font-semibold uppercase tracking-[0.12em] text-[var(--color-faint)]">
    Narzędzia
  </h2>
  <div class="flex flex-col gap-2">
    <Destination
      href={`${base}plan/`}
      pl="Plan"
      ru="Расписание"
      hint="Do którego dzwonka, co wziąć na jutro, czy sprawdzian zapowiedziano legalnie"
    />
    <Destination
      href={`${base}kalkulatory/`}
      pl="Kalkulatory"
      ru="Калькуляторы"
      hint="Ile jeszcze możesz opuścić i jaka ocena jest potrzebna na koniec"
    />
    <Destination
      href={`${base}warsztat/`}
      pl="Warsztat"
      ru="Мастерская"
      hint="SQL na prawdziwym silniku, PHP 8 w przeglądarce, podgląd układu Androida"
    />
    <Destination
      href={`${base}lektury/`}
      pl="Lektury"
      ru="Книги"
      badge={`${audiobooks} ♪`}
      hint="Pełne teksty za darmo, większość z audiobookiem"
    />
  </div>

  <h2 class="mt-7 mb-2 text-label font-semibold uppercase tracking-[0.12em] text-[var(--color-faint)]">
    Terminy i pieniądze
  </h2>
  <ObligationList client:load obligations={obligations} />

  <p class="mt-7 text-micro text-[var(--color-faint)]">
    Aplikacja nie ma serwera, więc dane nie mają dokąd wyjechać. · У приложения нет сервера,
    данным некуда уехать.
  </p>
</Base>
