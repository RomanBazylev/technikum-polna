---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Destination from '../components/Destination.astro';
import Term from '../components/Term.astro';

const [topics, glossary, effects, subjects] = await Promise.all([
  getCollection('topics'),
  getCollection('glossary'),
  getCollection('effects'),
  getCollection('subjects'),
]);

const unitIdOf = (detailedId: string): string => detailedId.replace(/\.\d+$/, '');
const topicsByUnit = new Map<string, typeof topics>();
for (const topic of topics) {
  for (const code of topic.data.effects) {
    const unitId = unitIdOf(code);
    topicsByUnit.set(unitId, [...(topicsByUnit.get(unitId) ?? []), topic]);
  }
}

const lektury = await getCollection('lektury');
const audiobooks = lektury.filter((entry) => entry.data.hasAudio).length;

const qualifications = ['INF.03', 'INF.04'] as const;
const base = import.meta.env.BASE_URL;
const hoursTotal = (hours: number[] | null): number | null =>
  hours === null ? null : hours.reduce((sum, value) => sum + value, 0);
---

<Base
  title="Nauka"
  tab="nauka"
  lead="Mapa programu, nie podręcznik. Карта программы, а не учебник."
>
  <Destination
    href={`${base}lektury/`}
    pl="Lektury"
    ru="Книги"
    badge={`${audiobooks} ♪`}
    hint={`Wszystkie ${lektury.length} pozycji w pełnym tekście za darmo, ${audiobooks} z audiobookiem`}
  />

  <section class="mt-7">
    <h2 class="text-label font-semibold uppercase tracking-[0.12em] text-[var(--color-faint)]">
      Siatka godzin, klasy I–V
    </h2>
    <p class="mt-1 mb-3 text-micro text-[var(--color-faint)]">
      Rozporządzenie Ministra Edukacji z 22 lipca 2026, Dz.U. 2026 poz. 1028, załącznik nr 5.
    </p>
    <div class="overflow-x-auto rounded-card border border-[var(--color-line)]">
      <table class="w-full text-label">
        <thead class="text-micro uppercase text-[var(--color-faint)]">
          <tr>
            <th class="p-2 text-left">Przedmiot</th>
            {[1, 2, 3, 4, 5].map((grade) => <th class="p-2 text-center">{grade}</th>)}
            <th class="p-2 text-center">Σ</th>
          </tr>
        </thead>
        <tbody>
          {
            subjects.map((subject) => (
              <tr class="border-t border-[var(--color-line)]">
                <td class="p-2">
                  <span class="font-medium">{subject.data.name.pl}</span>
                  <span class="block text-micro text-[var(--color-faint)]">
                    {subject.data.name.ru}
                  </span>
                  {subject.data.textbook ? (
                    <span class="block text-micro text-[var(--color-faint)]">
                      {subject.data.textbook}
                    </span>
                  ) : null}
                </td>
                {[0, 1, 2, 3, 4].map((index) => (
                  <td class="p-2 text-center tabular-nums text-[var(--color-muted)]">
                    {subject.data.hoursByGrade === null
                      ? '·'
                      : subject.data.hoursByGrade[index] === 0
                        ? ''
                        : subject.data.hoursByGrade[index]}
                  </td>
                ))}
                <td class="p-2 text-center font-semibold tabular-nums">
                  {hoursTotal(subject.data.hoursByGrade) ?? '·'}
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <p class="mt-2 text-micro text-[var(--color-faint)]">
      Kropka oznacza, że rozłożenie godzin na klasy ustala dyrektor szkoły. ·
      Точка означает, что распределение часов по классам определяет директор.
    </p>
  </section>

  {
    qualifications.map((qualification) => (
      <section class="mt-7">
        <h2 class="mb-2 text-label font-semibold uppercase tracking-[0.12em] text-[var(--color-faint)]">
          {qualification} · jednostki efektów kształcenia
        </h2>
        <ul class="flex flex-col gap-2">
          {effects
            .filter((effect) => effect.data.qualification === qualification)
            .map((effect) => {
              const related = topicsByUnit.get(effect.data.id) ?? [];
              return (
                <li class="rounded-card border border-[var(--color-line)] p-3.5">
                  <p class="font-mono text-micro text-[var(--color-accent)]">{effect.data.id}</p>
                  <p class="mt-0.5 text-body font-semibold">{effect.data.name}</p>
                  <p class="mt-1 text-micro text-[var(--color-faint)]">
                    {effect.data.subjects.join(' · ')} — klasy {effect.data.grades.join(', ')}
                  </p>
                  {
                    effect.data.mappingStatus === 'unconfirmed' ? (
                      <p class="mt-2 rounded-lg border border-[var(--color-warn)]/40 p-2 text-micro text-[var(--color-muted)]">
                        Niepotwierdzone przez szkołę: {effect.data.mappingNote.pl} ·{' '}
                        {effect.data.mappingNote.ru}
                      </p>
                    ) : null
                  }
                  {related.length > 0 ? (
                    <ul class="mt-2 list-disc pl-5 text-label text-[var(--color-muted)]">
                      {related.map((topic) => (
                        <li>{topic.data.title}</li>
                      ))}
                    </ul>
                  ) : null}
                </li>
              );
            })}
        </ul>
      </section>
    ))
  }

  <section class="mt-7">
    <h2 class="mb-2 text-label font-semibold uppercase tracking-[0.12em] text-[var(--color-faint)]">
      Słownik, {glossary.length} haseł
    </h2>
    <p class="mb-3 text-micro text-[var(--color-faint)]">
      Polskie hasło, po naciśnięciu rosyjski i wymowa. · Польский термин, по нажатию русский и озвучка.
    </p>
    <div class="flex flex-wrap gap-2">
      {glossary.map((entry) => (
        <Term pl={entry.data.pl} ru={entry.data.ru} note={entry.data.note?.ru} />
      ))}
    </div>
  </section>

  <p class="mt-7 text-micro text-[var(--color-faint)]">
    Własnej teorii nie piszemy tam, gdzie poprawności nie da się sprawdzić uruchomieniem kodu.
    Do matematyki, fizyki i polskiego prowadzimy na ZPE, Pi-stację i Wolne Lektury. ·
    Свою теорию пишем только там, где правильность проверяется запуском кода.
  </p>
</Base>
