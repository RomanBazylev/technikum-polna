---
import Base from '../layouts/Base.astro';
import Destination from '../components/Destination.astro';

const base = import.meta.env.BASE_URL;

const qualifications = [
  {
    code: 'INF.03',
    name: 'Tworzenie i administrowanie stronami i aplikacjami internetowymi oraz bazami danych',
    when: 'Po 3 klasie, wg strony szkoły',
    practical: '150 minut, model dk',
    results: [
      'operacje na bazie danych',
      'wygląd witryny internetowej',
      'działanie witryny internetowej',
      'styl CSS witryny',
      'skrypt połączenia z bazą',
    ],
  },
  {
    code: 'INF.04',
    name: 'Projektowanie, programowanie i testowanie aplikacji',
    when: 'Po 4 klasie, wg strony szkoły',
    practical: '180 minut, model dk',
    results: [
      'implementacja, kompilacja i uruchomienie',
      'aplikacja konsolowa',
      'aplikacja mobilna',
      'dokumentacja aplikacji',
    ],
  },
];
---

<Base
  title="Egzaminy"
  tab="egzaminy"
  lead="Dwie kwalifikacje i matura. Две квалификации и матура."
>
  <Destination
    href={`${base}warsztat/`}
    pl="Warsztat"
    ru="Мастерская"
    hint="SQL na prawdziwym silniku, PHP 8 w przeglądarce, podgląd układu Androida i obróbka obrazów"
  />

  <section class="mt-7 flex flex-col gap-2">
    {
      qualifications.map((item) => (
        <article class="rounded-card border border-[var(--color-line)] bg-[var(--color-ink-soft)] p-4">
          <h2 class="font-mono text-title font-semibold text-[var(--color-accent)]">{item.code}</h2>
          <p class="mt-1 text-body">{item.name}</p>
          <dl class="mt-3 grid grid-cols-[auto_1fr] gap-x-3 gap-y-1 text-label">
            <dt class="text-[var(--color-faint)]">Termin</dt>
            <dd>{item.when}</dd>
            <dt class="text-[var(--color-faint)]">Część praktyczna</dt>
            <dd>{item.practical}</dd>
          </dl>
          <p class="mt-3 text-micro uppercase tracking-[0.12em] text-[var(--color-faint)]">
            Oceniane rezultaty
          </p>
          <ul class="mt-1 list-disc pl-5 text-label text-[var(--color-muted)]">
            {item.results.map((result) => (
              <li>{result}</li>
            ))}
          </ul>
        </article>
      ))
    }
  </section>

  <section class="mt-2 rounded-card border border-[var(--color-line)] p-4">
    <h2 class="text-body font-semibold">Kiedy dokładnie</h2>
    <p class="mt-2 text-label text-[var(--color-muted)]">
      Egzaminy zawodowe tego rocznika są w <strong
        class="font-semibold text-[var(--color-paper)]">Formule 2019</strong
      >. Strona TKK podaje INF.03 po klasie 3 i INF.04 po klasie 4; prawo nie narzuca konkretnej
      klasy. Dla oddziału 1B oznaczałoby to najpewniej lato 2029 i lato 2030, ale szkoła nie
      opublikowała jeszcze planu tego oddziału, a CKE nie ogłosiła harmonogramów na te lata. ·
      Профэкзамены проходят по формуле 2019. Точные сессии для 1B школа и CKE ещё не опубликовали.
    </p>
  </section>

  <section class="mt-2 rounded-card border border-[var(--color-line)] p-4">
    <h2 class="text-body font-semibold">Progi</h2>
    <p class="mt-2 text-label text-[var(--color-muted)]">
      Część pisemna: 60 minut, 40 zadań zamkniętych, próg <strong
        class="font-semibold text-[var(--color-paper)]">50%</strong
      >, czyli minimum 20 punktów. Egzamin odbywa się przy komputerze, pytania losowane są z
      centralnej bazy dla każdego zdającego osobno. Część praktyczna: próg <strong
        class="font-semibold text-[var(--color-paper)]">75%</strong
      >. Zdać trzeba obie.
    </p>
  </section>

  <section
    class="mt-2 rounded-card border border-[var(--color-good)]/40 bg-[var(--color-ink-soft)] p-4"
  >
    <h2 class="text-body font-semibold text-[var(--color-good)]">
      To warto wiedzieć od pierwszej klasy
    </h2>
    <p class="mt-2 text-label text-[var(--color-muted)]">
      Zdanie <strong class="font-semibold text-[var(--color-paper)]">obu</strong> kwalifikacji
      zwalnia z obowiązkowego przedmiotu dodatkowego na maturze, art. 44zzd ust. 4b ustawy o
      systemie oświaty. Dla takiego absolwenta maturę zdaje się przy 30% z każdego przedmiotu
      obowiązkowego, a przepis o progu na przedmiocie dodatkowym po prostu go nie dotyczy.
    </p>
    <p class="mt-2 text-label text-[var(--color-faint)]">
      Ale to plan awaryjny, nie strategia: jeśli INF.04 się nie uda, zwolnienie znika na kilka
      tygodni przed maturą. Jedno rozszerzenie i tak trzeba przygotować.
    </p>
  </section>
</Base>
