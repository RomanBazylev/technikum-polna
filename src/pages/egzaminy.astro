---
import Base from '../layouts/Base.astro';

const base = import.meta.env.BASE_URL;

const qualifications = [
  {
    code: 'INF.03',
    name: 'Tworzenie i administrowanie stronami i aplikacjami internetowymi oraz bazami danych',
    when: 'Po 3 klasie, wg strony szkoły',
    practical: '150 minut, model dk',
    results: [
      'operacje na bazie danych',
      'wygląd witryny internetowej',
      'działanie witryny internetowej',
      'styl CSS witryny',
      'skrypt połączenia z bazą',
    ],
  },
  {
    code: 'INF.04',
    name: 'Projektowanie, programowanie i testowanie aplikacji',
    when: 'Po 4 klasie, wg strony szkoły',
    practical: '180 minut, model dk',
    results: [
      'implementacja, kompilacja i uruchomienie',
      'aplikacja konsolowa',
      'aplikacja mobilna',
      'dokumentacja aplikacji',
    ],
  },
];
---

<Base
  title="Egzaminy"
  tab="egzaminy"
  lead="Dwie kwalifikacje i matura. Две квалификации и матура."
>
  <a
    href={`${base}warsztat/`}
    class="mb-6 block rounded-xl border-l-4 border-[var(--color-accent)] bg-[var(--color-ink-soft)]/60 p-4"
  >
    <span class="block font-medium">Warsztat</span>
    <span class="block text-sm opacity-70">
      Piaskownica SQL na prawdziwym silniku i przygotowanie obrazów, jak w części praktycznej
    </span>
    <span class="mt-1 block text-xs opacity-60">Песочница SQL и подготовка изображений</span>
  </a>

  <section class="flex flex-col gap-4">
    {
      qualifications.map((item) => (
        <article class="rounded-xl border border-[var(--color-line)] bg-[var(--color-ink-soft)]/60 p-4">
          <h2 class="font-mono text-lg">{item.code}</h2>
          <p class="mt-1 text-sm opacity-80">{item.name}</p>
          <dl class="mt-3 grid grid-cols-2 gap-2 text-sm">
            <dt class="opacity-60">Termin</dt>
            <dd>{item.when}</dd>
            <dt class="opacity-60">Część praktyczna</dt>
            <dd>{item.practical}</dd>
          </dl>
          <p class="mt-3 text-xs uppercase tracking-wide opacity-60">Oceniane rezultaty</p>
          <ul class="mt-1 list-disc pl-5 text-sm opacity-90">
            {item.results.map((result) => (
              <li>{result}</li>
            ))}
          </ul>
        </article>
      ))
    }
  </section>

  <section class="mt-6 rounded-xl border border-[var(--color-line)] p-4">
    <h2 class="font-medium">Progi</h2>
    <p class="mt-2 text-sm opacity-90">
      Część pisemna: 60 minut, 40 zadań zamkniętych, próg <strong>50%</strong>, czyli minimum 20
      punktów. Egzamin odbywa się przy komputerze, pytania losowane są z centralnej bazy dla
      każdego zdającego osobno. Część praktyczna: próg <strong>75%</strong>. Zdać trzeba obie.
    </p>
  </section>

  <section class="mt-6 rounded-xl border-l-4 border-[var(--color-good)] bg-[var(--color-ink-soft)]/60 p-4">
    <h2 class="font-medium">To warto wiedzieć od pierwszej klasy</h2>
    <p class="mt-2 text-sm opacity-90">
      Zdanie <strong>obu</strong> kwalifikacji zwalnia z obowiązkowego przedmiotu dodatkowego na
      maturze, art. 44zzd ust. 4b ustawy o systemie oświaty. Dla takiego absolwenta maturę zdaje
      się przy 30% z każdego przedmiotu obowiązkowego, a przepis o progu na przedmiocie dodatkowym
      po prostu go nie dotyczy.
    </p>
    <p class="mt-2 text-sm opacity-70">
      Ale to plan awaryjny, nie strategia: jeśli INF.04 się nie uda, zwolnienie znika na kilka
      tygodni przed maturą. Jedno rozszerzenie i tak trzeba przygotować.
    </p>
  </section>
</Base>
