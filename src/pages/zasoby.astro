---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import type { Source } from '../lib/domain/types';

const [handbook, topics, obligations] = await Promise.all([
  getCollection('handbook'),
  getCollection('topics'),
  getCollection('obligations'),
]);

type Row = {
  provider: string;
  title: string;
  url: string | null;
  usage: { pl: string; ru: string };
  license: string;
  why: string | null;
};

/**
 * Происхождение материала уже описано схемой коллекции, поэтому каталог его не
 * пересказывает, а разворачивает. Ссылочный вариант лицензии не несёт вовсе:
 * поле why объясняет, почему её нет, и именно оно попадает на экран.
 */
function toRow(source: Source): Row {
  switch (source.kind) {
    case 'link-only':
      return {
        provider: source.provider,
        title: source.title,
        url: source.url,
        usage: { pl: 'tylko odnośnik', ru: 'только ссылка' },
        license: 'licencja nieokreślona',
        why: source.why,
      };
    case 'embeddable':
      return {
        provider: source.attribution,
        title: source.title,
        url: source.url,
        usage: { pl: 'można osadzić', ru: 'можно встроить' },
        license: source.license,
        why: null,
      };
    case 'authored':
      return {
        provider: source.author,
        title: 'Materiał własny',
        url: null,
        usage: { pl: 'nasze', ru: 'наше' },
        license: source.license,
        why: null,
      };
    default: {
      const exhaustive: never = source;
      throw new Error(`Необработанное происхождение: ${JSON.stringify(exhaustive)}`);
    }
  }
}

const collected: Source[] = [
  ...handbook.flatMap((entry) => entry.data.sources),
  ...topics.flatMap((entry) => entry.data.sources),
  ...obligations.flatMap((entry) => entry.data.sources),
];

// Справочник двуязычен, поэтому один и тот же источник приходит дважды.
const byKey = new Map<string, Row>();
for (const source of collected) {
  const row = toRow(source);
  byKey.set(`${row.provider}|${row.title}|${row.url ?? ''}`, row);
}

const byProvider = new Map<string, Row[]>();
for (const row of byKey.values()) {
  byProvider.set(row.provider, [...(byProvider.get(row.provider) ?? []), row]);
}
const providers = [...byProvider.keys()].sort((a, b) => a.localeCompare(b, 'pl'));

type Curated = {
  name: string;
  url: string;
  license: string;
  pl: string;
  ru: string;
  links?: { label: string; url: string }[];
};

const curated: Curated[] = [
  {
    name: 'ZPE, zpe.gov.pl',
    url: 'https://zpe.gov.pl/',
    license: 'wolne, licencja ustalana per materiał, często CC BY 3.0',
    pl: 'Państwowa platforma edukacyjna. Za darmo, bez konta, licencję każdego materiału trzeba sprawdzić osobno.',
    ru: 'Государственная образовательная платформа, бесплатно и без аккаунта.',
    links: [
      { label: 'Wzorce projektowe, INF.04', url: 'https://zpe.gov.pl/a/wprowadzenie/D4wJm4F8w' },
      { label: 'SQL, INF.03', url: 'https://zpe.gov.pl/a/instrukcja-uzytkowania/DTLoUvqQU' },
    ],
  },
  {
    name: 'Wolne Lektury, wolnelektury.pl',
    url: 'https://wolnelektury.pl/',
    license: 'domena publiczna i wolne licencje',
    pl: 'Pełne teksty lektur, część z audiobookiem. Zasila naszą półkę lektur.',
    ru: 'Полные тексты школьных лектур, часть с озвучкой. Из них собрана наша полка.',
  },
  {
    name: 'zadania.info',
    url: 'https://zadania.info/',
    license: 'treści zadań na CC BY-SA 4.0',
    pl: 'Treści zadań z matematyki. Głębokie linkowanie jest wprost dozwolone, rozwiązania są płatne i ich tu nie ma.',
    ru: 'Условия задач по математике. Прямые ссылки разрешены автором, решения платные и сюда не входят.',
  },
  {
    name: 'Pi-stacja, pistacja.tv',
    url: 'https://pistacja.tv/',
    license: 'CC BY-NC-SA, dlatego wyłącznie odnośnik',
    pl: 'Darmowe wideo do matematyki, fizyki, chemii i biologii, otagowane kodami podstawy programowej. Osadzić nie wolno, bo NC nie łączy się z naszą CC BY-SA.',
    ru: 'Бесплатные видео по математике, физике, химии и биологии с кодами программы. Встраивать нельзя.',
  },
  {
    name: 'Khan Academy po polsku, pl.khanacademy.org',
    url: 'https://pl.khanacademy.org/',
    license: 'CC BY-NC-SA, dlatego wyłącznie odnośnik',
    pl: 'Kursy z matematyki po polsku, z zadaniami i natychmiastową informacją zwrotną.',
    ru: 'Курсы математики на польском с задачами и мгновенной проверкой.',
  },
  {
    name: 'DW Learn German, learngerman.dw.com',
    url: 'https://learngerman.dw.com/pl/',
    license: 'darmowe, materiał Deutsche Welle',
    pl: 'Poziomy A1–C1 z polskim interfejsem, więc nie trzeba znać angielskiego, żeby zacząć. Pasuje do podręcznika Effekt Neu.',
    ru: 'Уровни A1–C1 с польским интерфейсом. Подходит к учебнику Effekt Neu.',
  },
  {
    name: 'British Council LearnEnglish',
    url: 'https://learnenglish.britishcouncil.org/',
    license: 'darmowe, materiał British Council',
    pl: 'Ułożone po poziomach CEFR, więc łatwo trafić w swój poziom po teście z 1 września.',
    ru: 'Разложено по уровням CEFR, легко попасть в свой после теста 1 сентября.',
  },
  {
    name: 'hiszpanski.ang.pl',
    url: 'https://hiszpanski.ang.pl/',
    license: 'darmowe, warunki ponownego użycia nieokreślone',
    pl: 'Gramatyka i ćwiczenia po polsku. Wolnego kursu A1 hiszpańskiego z polskim interfejsem i dobrą jakością po prostu nie ma, dlatego ten przedmiot jest u nas obstawiony najsłabiej.',
    ru: 'Грамматика и упражнения по-польски. Бесплатного качественного курса испанского A1 с польским интерфейсом не существует, поэтому этот предмет покрыт хуже всех.',
  },
  {
    name: 'curso.pl',
    url: 'https://curso.pl/',
    license: 'darmowe, warunki ponownego użycia nieokreślone',
    pl: 'Drugi punkt zaczepienia do hiszpańskiego po polsku.',
    ru: 'Вторая опора для испанского на польском.',
  },
  {
    name: 'CKE, przykładowe zadania praktyczne',
    url: 'https://cke.gov.pl/',
    license: 'CKE nie publikuje warunków ponownego użycia, więc tylko odnośnik',
    pl: 'Zadania tego samego typu, co na egzaminie zawodowym. Najbliższa rzecz do prawdziwego arkusza.',
    ru: 'Задания того же типа, что на профессиональном экзамене.',
    links: [
      {
        label: 'INF.03',
        url: 'https://cke.gov.pl/images/_EGZAMIN_ZAWODOWY/Formula_2019/Przykladowe_zadania/inf_03.pdf',
      },
      {
        label: 'INF.04',
        url: 'https://cke.gov.pl/images/_EGZAMIN_ZAWODOWY/Formula_2019/Przykladowe_zadania/inf_04.pdf',
      },
    ],
  },
];

const base = import.meta.env.BASE_URL;
---

<Base
  title="Zasoby"
  tab="szkola"
  lead="Skąd brać materiały i na jakich warunkach. Откуда брать материалы и на каких условиях."
>
  <section class="rounded-xl border-l-4 border-[var(--color-accent)] p-4">
    <h2 class="font-medium">Dlaczego prawie wszystko jest tylko odnośnikiem</h2>
    <p class="mt-2 text-sm opacity-80">
      Te materiały nie są nasze. Większość z nich nie ma żadnej licencji na ponowne wykorzystanie,
      a Pi-stacja i Khan Academy mają licencję z członem NC, której nie wolno łączyć z naszą CC
      BY-SA na jednej stronie. Dlatego prowadzimy do oryginału zamiast go kopiować: kopia i tak
      zdezaktualizowałaby się szybciej niż źródło.
    </p>
    <p class="mt-2 text-sm opacity-70">
      Материалы чужие. У большинства нет лицензии на переиспользование, а у Pi-stacja и Khan
      Academy лицензия с NC, которую нельзя смешивать с нашей CC BY-SA. Поэтому ведём на оригинал,
      а не копируем.
    </p>
  </section>

  <section class="mt-8">
    <h2 class="mb-3 text-sm font-medium uppercase tracking-wide opacity-70">
      Polecane, {curated.length} pozycji
    </h2>
    <ul class="flex flex-col gap-3">
      {
        curated.map((item) => (
          <li class="rounded-xl border border-[var(--color-line)] bg-[var(--color-ink-soft)]/60 p-4">
            <a class="font-medium underline" href={item.url} rel="noopener">
              {item.name}
            </a>
            <p class="mt-1 text-sm opacity-80">{item.pl}</p>
            <p class="mt-1 text-sm opacity-60">{item.ru}</p>
            <p class="mt-2 text-xs opacity-60">{item.license}</p>
            {item.links ? (
              <ul class="mt-2 flex flex-wrap gap-3 text-sm">
                {item.links.map((link) => (
                  <li>
                    <a class="underline" href={link.url} rel="noopener">
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            ) : null}
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mt-8">
    <h2 class="mb-1 text-sm font-medium uppercase tracking-wide opacity-70">
      Źródła z tego serwisu, {byKey.size} pozycji
    </h2>
    <p class="mb-3 text-xs opacity-60">
      Wszystko, na co powołuje się przewodnik, tematy i terminy, zebrane w jednym miejscu. ·
      Всё, на что ссылаются справочник, темы и сроки, собрано в одном месте.
    </p>
    <div class="flex flex-col gap-4">
      {
        providers.map((provider) => (
          <div class="rounded-xl border border-[var(--color-line)] p-4">
            <h3 class="font-medium">{provider}</h3>
            <ul class="mt-2 flex flex-col gap-3">
              {(byProvider.get(provider) ?? []).map((row) => (
                <li>
                  {row.url === null ? (
                    <span class="text-sm font-medium">{row.title}</span>
                  ) : (
                    <a class="text-sm underline" href={row.url} rel="noopener">
                      {row.title}
                    </a>
                  )}
                  <p class="mt-1 text-xs opacity-60">
                    {row.usage.pl} · {row.usage.ru} · {row.license}
                  </p>
                  {row.why === null ? null : (
                    <p class="mt-1 text-xs opacity-50">{row.why}</p>
                  )}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>

  <section class="mt-8 rounded-xl border border-[var(--color-line)] p-4">
    <h2 class="font-medium">Czego tu nie znajdziesz</h2>
    <p class="mt-2 text-sm opacity-80">
      Nie prowadzimy do serwisów z gotowymi odpowiedziami do tych samych podręczników, których
      używa ta szkoła. Ich prawa do treści są wątpliwe, a istnieją po to, żeby przepisać, a nie
      zrozumieć. Na egzaminie zawodowym nie ma z czego przepisać.
    </p>
    <p class="mt-2 text-sm opacity-70">
      Мы не ведём на сайты с готовыми ответами к тем же учебникам, по которым учится эта школа.
      Права на их содержимое сомнительны, а нужны они, чтобы списать, а не понять. На экзамене
      списывать будет не у кого.
    </p>
  </section>

  <a class="mt-6 inline-block text-sm underline" href={`${base}szkola/`}>Wróć do „Szkoła”</a>
</Base>
