---
import '../styles/global.css';

type Props = {
  title: string;
  tab: 'dzis' | 'nauka' | 'egzaminy' | 'szkola';
  lead?: string;
};

const { title, tab, lead } = Astro.props;
const base = import.meta.env.BASE_URL;

const tabs = [
  { id: 'dzis', href: base, label: 'Dziś', ru: 'Сегодня' },
  { id: 'nauka', href: `${base}nauka/`, label: 'Nauka', ru: 'Учёба' },
  { id: 'egzaminy', href: `${base}egzaminy/`, label: 'Egzaminy', ru: 'Экзамены' },
  { id: 'szkola', href: `${base}szkola/`, label: 'Szkoła', ru: 'Школа' },
] as const;
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#0a0e14" />
    <meta name="description" content="Przewodnik i narzędzia dla uczniów TKK Polna, technik programista." />
    <title>{title}</title>
    <link rel="icon" href={`${base}icon.svg`} type="image/svg+xml" />
    <link rel="manifest" href={`${base}manifest.webmanifest`} />
  </head>
  <body>
    <main class="mx-auto w-full max-w-2xl px-4 pt-7">
      <slot name="header">
        <header class="mb-6">
          <h1 class="text-display font-semibold">{title}</h1>
          {lead ? <p class="mt-2 text-body text-[var(--color-muted)]">{lead}</p> : null}
        </header>
      </slot>
      <slot />
    </main>

    <nav
      aria-label="Główna nawigacja"
      class="fixed inset-x-0 bottom-0 z-30 border-t border-[var(--color-line)] bg-[var(--color-ink)]/95 backdrop-blur"
      style="padding-bottom: env(safe-area-inset-bottom)"
    >
      <ul class="mx-auto flex w-full max-w-2xl">
        {
          tabs.map((item) => (
            <li class="flex-1">
              <a
                href={item.href}
                aria-current={item.id === tab ? 'page' : undefined}
                class:list={[
                  'relative flex flex-col items-center gap-0.5 py-3.5',
                  item.id === tab ? 'text-[var(--color-accent)]' : 'text-[var(--color-muted)]',
                ]}
              >
                {item.id === tab ? (
                  <span class="absolute inset-x-5 top-0 h-0.5 rounded-b bg-[var(--color-accent)]" />
                ) : null}
                <span class="text-label font-semibold">{item.label}</span>
                <span class="text-micro text-[var(--color-muted)]">{item.ru}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <script>
      // Регистрируем воркер вручную: injectRegister отключён, потому что
      // Astro не прогоняет свои страницы через трансформацию index.html.
      if ('serviceWorker' in navigator && import.meta.env.PROD) {
        window.addEventListener('load', () => {
          const base = import.meta.env.BASE_URL;

          // Перезагружаем только при смене уже работавшего воркера. При первой
          // установке контроллера ещё нет, и перезагрузка была бы напрасной:
          // страница и так свежая, а посетитель увидел бы моргание.
          if (navigator.serviceWorker.controller !== null) {
            let reloading = false;
            navigator.serviceWorker.addEventListener('controllerchange', () => {
              if (reloading) return;
              reloading = true;
              window.location.reload();
            });
          }

          navigator.serviceWorker
            .register(`${base}sw.js`, { scope: base })
            .then((registration) => {
              // Проверяем обновление при каждом запуске и раз в час, если
              // вкладку держат открытой неделями.
              void registration.update();
              window.setInterval(() => void registration.update(), 60 * 60 * 1000);
            })
            .catch(() => {
              // Офлайн - улучшение, а не условие работы. Молча продолжаем.
            });
        });
      }
    </script>
  </body>
</html>
